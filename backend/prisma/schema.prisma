generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────
// Enums
// ──────────────────────────────────────

enum UserRole {
  USER
  EXPERT
  ADMIN
}

enum PronoResult {
  PENDING
  WON
  LOST
}

enum PronoTeasing {
  PICK_SOLIDE
  VALUE
  SAFE
  OPPORTUNITE
  PICK_DU_JOUR
  A_NE_PAS_RATER
}

enum SubscriptionType {
  DAY_PASS
  MONTHLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ExpertSubStatus {
  FREE
  ACTIVE
  EXPIRED
}

enum Sport {
  FOOTBALL
  TENNIS
  BASKETBALL
  RUGBY
  HOCKEY
  MMA
  BOXE
  ESPORT
  AUTRE
}

// ──────────────────────────────────────
// Models
// ──────────────────────────────────────

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  // Customer Stripe (cus_…) enregistré au premier paiement et réutilisé
  // ensuite, pour éviter les doublons côté Stripe.
  stripeCustomerId  String?  @unique
  role              UserRole @default(USER)
  // Soft delete RGPD : à la suppression, deletedAt est posé et l'email
  // anonymisé (`deleted-{id}@plarya.local`). La ligne est conservée pour
  // l'historique comptable des Subscriptions.
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  expert        Expert?
  subscriptions Subscription[]
  sessions      Session[]

  @@index([deletedAt])
  @@map("users")
}

// Cooldown après suppression de compte. L'email du User étant anonymisé, un
// nouveau magic-link sur l'adresse d'origine recréerait aussitôt un compte.
// L'adresse est donc conservée ici 7 jours : pendant ce délai, aucun magic-link
// n'est envoyé (réponse HTTP inchangée) ni accepté. Les lignes expirées sont
// purgées chaque nuit (lib/cron.ts).
model DeletedEmailCooldown {
  id        String   @id @default(cuid())
  email     String
  deletedAt DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("deleted_email_cooldowns")
}

model MagicLink {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([token])
  @@map("magic_links")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

model Expert {
  id              String          @id @default(cuid())
  userId          String          @unique
  pseudo          String          @unique
  bio             String?
  photoUrl        String?
  sports          Sport[]
  dayPassPrice    Int             @default(350)  // centimes (3.50€)
  monthlyPrice    Int             @default(2900) // centimes (29€)
  subStatus       ExpertSubStatus @default(FREE)
  subExpiresAt    DateTime?
  stripeSubId     String?         // abonnement Stripe trimestriel de l'expert
  // Résiliation demandée : l'abonnement Stripe s'arrête à la fin de la
  // période payée (le webhook customer.subscription.deleted passe alors
  // subStatus à EXPIRED).
  subCancelAtPeriodEnd Boolean   @default(false)
  warningMessage  String?
  dailyNote       String?
  dailyNoteDate   DateTime?
  displayOrder    Int             @default(0)
  viewsToday      Int             @default(0)
  // Soft delete RGPD (voir User.deletedAt) : profil masqué publiquement,
  // conservé pour l'historique des Subscriptions.
  deletedAt       DateTime?
  // Suppression programmée tant que des Subscriptions ACTIVE courent : profil
  // retiré des listings, nouveaux paiements refusés, accès existants maintenus.
  // Un cron finalise la suppression après la dernière échéance ; l'expert
  // peut annuler d'ici là.
  pendingDeletionAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pronos          Prono[]
  subscriptions   Subscription[]

  @@index([deletedAt])
  @@index([pendingDeletionAt])
  @@index([stripeSubId])
  @@map("experts")
}

model Prono {
  id          String       @id @default(cuid())
  expertId    String
  matchName   String       // ex: "PSG - Marseille"
  league      String?      // ex: "Ligue 1"
  pick        String       // ex: "PSG gagne"
  odds        Float        // cote de l'expert
  teasing     PronoTeasing
  result      PronoResult  @default(PENDING)
  argument    String?      // argumentaire (visible après achat)
  startTime   DateTime     // heure de début du match
  isFeatured  Boolean      @default(false)
  matchDate   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  expert        Expert               @relation(fields: [expertId], references: [id], onDelete: Cascade)
  bookmakerOdds PronoBookmakerOdds[]

  @@index([expertId, createdAt(sort: Desc)])
  @@map("pronos")
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String
  expertId              String
  type                  SubscriptionType
  status                SubscriptionStatus @default(ACTIVE)
  stripeSessionId       String?            @unique
  stripeSubId           String?
  checkoutSessionUsed   Boolean            @default(false)
  // Résiliation demandée : pas de renouvellement, accès jusqu'à expiresAt.
  cancelAtPeriodEnd     Boolean            @default(false)
  expiresAt             DateTime
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  expert            Expert             @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expertId])
  @@index([expiresAt])
  @@index([stripeSubId])
  @@map("subscriptions")
}

model Bookmaker {
  id             String          @id @default(cuid())
  name           String          @unique // Winamax, Betclic, PMU
  logoUrl        String?
  createdAt      DateTime        @default(now())

  affiliateLinks AffiliateLink[]
  pronoOdds      PronoBookmakerOdds[]

  @@map("bookmakers")
}

model AffiliateLink {
  id           String    @id @default(cuid())
  bookmakerId  String
  url          String
  label        String?   // ex: "Parier +100€"
  createdAt    DateTime  @default(now())

  bookmaker    Bookmaker @relation(fields: [bookmakerId], references: [id], onDelete: Cascade)

  @@map("affiliate_links")
}

// Idempotence des webhooks Stripe : un événement (evt_…) est enregistré dans
// la même transaction que son traitement ; une nouvelle livraison du même
// événement est ignorée (routes/webhooks.ts). `payload` est conservé pour
// l'audit ; aucune purge automatique n'est en place.
model StripeWebhookEvent {
  id          String   @id  // evt_xxx fourni par Stripe
  eventType   String
  payload     Json?
  processedAt DateTime @default(now())

  @@index([processedAt])
  @@map("stripe_webhook_events")
}

model PronoBookmakerOdds {
  id           String    @id @default(cuid())
  pronoId      String
  bookmakerId  String
  odds         Float

  prono        Prono     @relation(fields: [pronoId], references: [id], onDelete: Cascade)
  bookmaker    Bookmaker @relation(fields: [bookmakerId], references: [id], onDelete: Cascade)

  @@unique([pronoId, bookmakerId])
  @@index([pronoId])
  @@map("prono_bookmaker_odds")
}
